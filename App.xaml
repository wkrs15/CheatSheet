<Application x:Class="CheatSheet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <!-- 没有 StartupUri:窗口由 App.OnStartup 亲手创建 ——
         在此之前要先做完"单实例"判断(第二个实例直接退出,不建窗口)
         和全局异常兜底(见 App.xaml.cs)。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControls 主题。注意:SkinDefault.xaml 自 3.1.0 起已移除,
                     现由 ThemeResources(颜色/皮肤) + Theme(控件样式) 两本字典组成。 -->
                <hc:ThemeResources />
                <hc:Theme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
