<Window x:Class="CheatSheet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="580"
        Title="设置 · CheatSheet"
        Width="580" Height="600"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingCaption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="HotkeyButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="显示与声音" Style="{StaticResource SectionTitle}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="画面透明度" Style="{StaticResource SettingCaption}" />
                <Slider x:Name="OpacitySlider" Grid.Column="1"
                        Minimum="30" Maximum="100" Value="100"
                        VerticalAlignment="Center"
                        ValueChanged="Opacity_ValueChanged"
                        ToolTip="只让视频画面变透明,进度条和设置窗口不受影响" />
                <TextBlock x:Name="OpacityValueText" Grid.Column="2"
                           Text="100%"
                           HorizontalAlignment="Right"
                           Style="{StaticResource SettingCaption}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="音量" Style="{StaticResource SettingCaption}" />
                <Slider x:Name="VolumeSlider" Grid.Column="1"
                        Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center"
                        ValueChanged="Volume_ValueChanged" />
                <TextBlock x:Name="VolumeValueText" Grid.Column="2"
                           Text="80%"
                           HorizontalAlignment="Right"
                           Style="{StaticResource SettingCaption}" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="播放倍速" Style="{StaticResource SettingCaption}" />
                <hc:ComboBox x:Name="SpeedBox" Grid.Column="1"
                             Width="96" Height="26"
                             HorizontalAlignment="Left"
                             VerticalContentAlignment="Center"
                             SelectionChanged="Speed_Changed">
                    <ComboBoxItem Content="0.5x" />
                    <ComboBoxItem Content="0.75x" />
                    <ComboBoxItem Content="1.0x" />
                    <ComboBoxItem Content="1.25x" />
                    <ComboBoxItem Content="1.5x" />
                    <ComboBoxItem Content="2.0x" />
                </hc:ComboBox>
            </Grid>

            <CheckBox x:Name="ProportionalBox"
                      Margin="0,12,0,0"
                      Content="拖动窗口边缘时保持等比例(按视频比例缩放)"
                      Click="Proportional_Click" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="全局热键" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="点右侧按键后按下新的组合键即完成改键(Esc 取消)。不带 Ctrl/Alt 等修饰键的单键也可以,但单键会抢占全局输入,建议用 F1-F12 这类功能键。全局热键在游戏全屏、播放窗口失焦时同样生效。"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl x:Name="HotkeyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource HotkeyButton}"
                                        Content="{Binding Gesture}"
                                        Click="HotkeyCapture_Click"
                                        Tag="{Binding}" />
                                <TextBlock Grid.Column="2"
                                           Width="112"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Status}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="恢复默认快捷键" Click="ResetHotkeys_Click" />
            <Button DockPanel.Dock="Right" Content="关闭" Width="96" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
