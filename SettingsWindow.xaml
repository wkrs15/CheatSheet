<Window x:Class="CheatSheet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="520" d:DesignWidth="540"
        Title="设置 · CheatSheet"
        Width="540" Height="520"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 分区标题:字小一点、留白收紧 —— 靠间距分组,不靠大标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingCaption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <!-- 行标签:固定 88px,几行控件左边缘对齐 -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingCaption}">
            <Setter Property="Width" Value="88" />
        </Style>

        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14,0,12" />
            <Setter Property="Background" Value="#1A808080" />
        </Style>

        <!-- 这里刻意**不给** RadioButton / CheckBox 自定义样式:元素上一旦有显式 Style,
             HandyControl 的隐式样式就整个失效(2026-09-18 用户发现单选框变成了系统原生样子)。
             间距直接用元素上的 Margin 给。 -->

        <!-- 快捷键的一行:悬停给一点点底色,一眼看清鼠标在哪一行 -->
        <Style x:Key="HotkeyRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15808080" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PagePanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="2,12,8,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部只留软件名 + 版本 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,8">
            <TextBlock Text="CheatSheet" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Margin="7,1,0,0" Padding="5,1" CornerRadius="4"
                    Background="#1F2E90FF" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Text="v0.0.0"
                           FontFamily="Consolas" FontSize="10.5" Foreground="#FF6CB6FF" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ============ 播放 ============ -->
            <TabItem Header="播放">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PagePanel}">

                        <TextBlock Text="播放模式" Style="{StaticResource SectionTitle}" />
                        <StackPanel ToolTip="切到浏览器模式会重新加载页面、播放位置不保留;切回本地模式会把内置浏览器关掉">
                            <RadioButton x:Name="VideoModeBox" Margin="0,0,0,6" GroupName="PlayMode"
                                                                                  Content="本地视频模式(播放视频文件)"
                                         Checked="PlayMode_Changed" />
                            <RadioButton x:Name="WebModeBox" Margin="0,0,0,6" GroupName="PlayMode"
                                                                                  Content="浏览器模式(播放网页视频,如 B 站)"
                                         Checked="PlayMode_Changed" />
                        </StackPanel>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="浏览器首页" Style="{StaticResource RowLabel}" />
                            <hc:TextBox x:Name="HomeUrlBox" Grid.Column="1"
                                        Height="26" VerticalContentAlignment="Center"
                                        TextChanged="HomeUrl_Changed"
                                        ToolTip="浏览器模式启动时打开的网址" />
                        </Grid>

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="暂停时" Style="{StaticResource SectionTitle}" />
                        <StackPanel ToolTip="本地视频和网页视频都适用:暂停时画面自己让开,不影响下面的游戏">
                            <RadioButton x:Name="PauseDimBox" Margin="0,0,0,6" GroupName="PauseBehavior"
                                                                                  Content="把画面调暗到 30%(默认)"
                                         Checked="PauseBehavior_Changed" />
                            <RadioButton x:Name="PauseNothingBox" Margin="0,0,0,6" GroupName="PauseBehavior"
                                                                                  Content="什么都不做"
                                         Checked="PauseBehavior_Changed" />
                            <RadioButton x:Name="PauseHideBox" GroupName="PauseBehavior"
                                         Content="隐藏视频窗口"
                                         Checked="PauseBehavior_Changed" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="播放行为" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ResumeBox" Margin="0,0,0,6"                                   Content="记住本地视频的播放进度(下次打开接着看)"
                                  Click="Resume_Click" />
                        <CheckBox x:Name="LoopBox"
                                  Content="循环播放:播完最后一集回到第一集"
                                  ToolTip="播放列表本来就会自动续播下一集;网页模式的 B 站多P 视频同样会自动接下一P"
                                  Click="Loop_Click" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 显示与声音 ============ -->
            <TabItem Header="显示与声音">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PagePanel}">

                        <TextBlock Text="画面" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="透明度" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="OpacitySlider" Grid.Column="1"
                                    Minimum="30" Maximum="100" Value="100"
                                    VerticalAlignment="Center"
                                    ValueChanged="Opacity_ValueChanged"
                                    ToolTip="只让视频画面变透明,进度条和设置窗口不受影响" />
                            <TextBlock x:Name="OpacityValueText" Grid.Column="2" Text="100%"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource SettingCaption}" />
                        </Grid>

                        <CheckBox x:Name="ProportionalBox" Margin="0,12,0,0"
                                  Content="拖动窗口边缘时保持等比例(按视频比例缩放)"
                                  Click="Proportional_Click" />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="声音与速度" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="80"
                                    VerticalAlignment="Center"
                                    ValueChanged="Volume_ValueChanged" />
                            <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="80%"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource SettingCaption}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放倍速" Style="{StaticResource RowLabel}" />
                            <hc:ComboBox x:Name="SpeedBox" Grid.Column="1"
                                         Width="110" Height="26"
                                         HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         SelectionChanged="Speed_Changed">
                                <ComboBoxItem Content="0.5x" />
                                <ComboBoxItem Content="0.75x" />
                                <ComboBoxItem Content="1.0x" />
                                <ComboBoxItem Content="1.25x" />
                                <ComboBoxItem Content="1.5x" />
                                <ComboBoxItem Content="2.0x" />
                            </hc:ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="控制条" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="出现延迟" Style="{StaticResource RowLabel}" />
                            <hc:ComboBox x:Name="BarDelayBox" Grid.Column="1"
                                         Width="150" Height="26"
                                         HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         ToolTip="鼠标停在屏幕最顶端多久之后控制条才伸出来;设长一点,扫过去点浏览器标签时就不会被它挡一下"
                                         SelectionChanged="BarDelay_Changed" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 快捷键 ============ -->
            <TabItem Header="快捷键">
                <DockPanel Margin="2,12,8,8" LastChildFill="True">

                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingCaption}"
                                   Text="点右侧按键,再按新的组合键(Esc 取消)—— 改完即时生效"
                                   ToolTip="不带 Ctrl/Alt 的单键也行,但会抢占全局输入,建议用 F1-F12。全局热键在游戏全屏、窗口失焦时同样生效。" />
                        <Button DockPanel.Dock="Right"
                                Content="恢复默认"
                                Height="26" Padding="12,0"
                                Click="ResetHotkeys_Click" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="HotkeyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HotkeyRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="128" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    MinWidth="132"
                                                    Height="26"
                                                    Margin="8,0"
                                                    Focusable="False"
                                                    Content="{Binding GestureDisplay}"
                                                    Click="HotkeyCapture_Click"
                                                    Tag="{Binding}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Status}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!-- 颜色写在 Style 里:局部设的值优先级比触发器高 -->
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFE0863A" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ 关于 ============ -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource PagePanel}">

                        <TextBlock Text="更新" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="还没检查过更新" />
                            <Button x:Name="CheckUpdateButton" Grid.Column="1"
                                    Content="检查更新" Height="26" Padding="12,0"
                                    Click="CheckUpdate_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="InstallUpdateButton"
                                    Content="下载并更新" Height="26" Padding="12,0"
                                    IsEnabled="False"
                                    Click="InstallUpdate_Click"
                                    ToolTip="下载新版本,替换后自动重启(绿色版覆盖不了运行中的自己,所以由一个小脚本在退出后接手)" />
                            <Button x:Name="DownloadButton"
                                    Content="打开下载页" Height="26" Padding="12,0" Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="OpenDownloadPage_Click" />
                        </StackPanel>

                        <CheckBox x:Name="AutoUpdateBox" Margin="0,12,0,0"
                                  Content="启动时自动检查更新(一天最多一次)"
                                  Click="AutoUpdate_Click" />

                        <Border Style="{StaticResource SectionRule}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开配置目录" Height="26" Padding="12,0"
                                    Click="OpenConfigFolder_Click" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SettingCaption}"
                                       Text="设置与崩溃日志都在 %AppData%\CheatSheet" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="关闭" Width="88" Height="28"
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
