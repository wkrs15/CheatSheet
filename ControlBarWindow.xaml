<Window x:Class="CheatSheet.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="42" d:DesignWidth="780"
        Title="CheatSheet · 控制条"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        Foreground="#F2FFFFFF"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 深色条上的按钮:自己画模板,不受浅色主题影响 -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarTextButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="46" />
        </Style>

        <Style x:Key="BarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>

        <!-- 「选集」下拉栏的按钮:一条胶囊,显示当前是第几集 + 一个下箭头 -->
        <Style x:Key="ChapterToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}"
                                           MaxWidth="168"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Margin="6,1,0,0"
                                           Foreground="#B3FFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉栏里的每一项 -->
        <Style x:Key="ChapterItemButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <!-- 行宽兜个底:否则标题长短不一会让高亮条的宽度参差不齐 -->
            <Setter Property="MinWidth" Value="360" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="6,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 地址栏输入框:自己画模板,不受浅色主题影响(和 BarButton 一个道理) -->
        <Style x:Key="AddressBox" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="CaretBrush" Value="#F2FFFFFF" />
            <Setter Property="SelectionBrush" Value="#FF2E90FF" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#E615171B"
            BorderBrush="#33FFFFFF"
            BorderThickness="0,0,1,1"
            CornerRadius="0,0,14,14"
            Padding="10,4">
        <StackPanel Orientation="Vertical">

            <!-- 地址栏:只有浏览器模式才出现,摆在按钮行上面。
                 点它的时候靠代码临时摘掉 WS_EX_NOACTIVATE,否则这条窗口根本收不到键盘。 -->
            <Grid x:Name="AddressRow"
                  Visibility="Collapsed"
                  Margin="3,4,3,4"
                  PreviewMouseLeftButtonDown="AddressRow_PreviewMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AddressBox"
                         Grid.Column="0"
                         Style="{StaticResource AddressBox}"
                         MinWidth="440"
                         ToolTip="输入网址后回车。按 Esc 取消"
                         KeyDown="Address_KeyDown"
                         GotKeyboardFocus="Address_GotKeyboardFocus"
                         LostKeyboardFocus="Address_LostKeyboardFocus" />

                <Button Grid.Column="1"
                        Style="{StaticResource BarTextButton}"
                        Content="前往"
                        Margin="6,0,0,0"
                        Click="Go_Click"
                        ToolTip="打开地址栏里的网址" />
            </Grid>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText"
                           MaxWidth="190"
                           Margin="4,0,2,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#B3FFFFFF"
                           Text="CheatSheet" />

                <!-- 鼠标穿透是个"开了容易忘"的状态,给它一个可见的标记 -->
                <Border x:Name="ClickThroughChip"
                        Visibility="Collapsed"
                        Margin="4,0,2,0"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="#332E90FF"
                        VerticalAlignment="Center">
                    <TextBlock Text="穿透中"
                               FontSize="11"
                               Foreground="#FF8EC2FF" />
                </Border>

                <Border Style="{StaticResource BarSeparator}" />

                <!-- 「播放器」下拉栏:网页模式下把播放器自己的画质 / 弹幕暴露出来,
                     省得为了切画质去点小窗里 B 站那套控制条 -->
                <ToggleButton x:Name="PlayerToggle"
                              Style="{StaticResource ChapterToggleButton}"
                              Visibility="Collapsed"
                              Click="PlayerToggle_Click"
                              ToolTip="播放器设置:画质 / 弹幕(网页模式)" />

                <Popup x:Name="PlayerPopup"
                       PlacementTarget="{Binding ElementName=PlayerToggle}"
                       Placement="Bottom"
                       VerticalOffset="2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="PlayerPopup_Opened"
                       Closed="PlayerPopup_Closed">
                    <Border Background="#F215171B"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,4,6,6"
                            Margin="0,0,8,8">
                        <StackPanel MinWidth="200">
                            <TextBlock Text="画质"
                                       Margin="6,4,4,6"
                                       FontSize="11"
                                       Foreground="#8CFFFFFF" />

                            <ItemsControl x:Name="QualityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChapterItemButton}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding Label}"
                                                Click="QualityItem_Click">
                                            <Grid Width="180">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="&#xE73E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="#FF2E90FF"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Margin="6,6,6,6" Background="#26FFFFFF" />

                            <Button Style="{StaticResource ChapterItemButton}"
                                    Click="Danmaku_Click">
                                <Grid Width="180">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="弹幕" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DanmakuStateText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="#B3FFFFFF" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="RecentToggle"
                              Style="{StaticResource ChapterToggleButton}"
                              Visibility="Collapsed"
                              Margin="1,0,1,0"
                              Click="RecentToggle_Click"
                              ToolTip="最近看过的视频(带上次的进度),点一下接着看" />

                <Popup x:Name="RecentPopup"
                       PlacementTarget="{Binding ElementName=RecentToggle}"
                       Placement="Bottom"
                       VerticalOffset="2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="RecentPopup_Opened"
                       Closed="RecentPopup_Closed">
                    <Border Background="#F215171B"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,0,8,8">
                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChapterItemButton}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding Path}"
                                                Click="RecentItem_Click">
                                            <Grid Width="360">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding ProgressText}"
                                                           FontFamily="Consolas"
                                                           Foreground="#B3FFFFFF"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- 选集下拉栏:网页模式 = B 站的分P,本地模式 = 播放列表。
                     只有一项时收起来(没得选)。 -->
                <ToggleButton x:Name="ChapterToggle"
                              Style="{StaticResource ChapterToggleButton}"
                              Visibility="Collapsed"
                              Click="ChapterToggle_Click"
                              ToolTip="选集:网页模式列出 B 站的分P,本地模式列出播放列表" />

                <Popup x:Name="ChapterPopup"
                       PlacementTarget="{Binding ElementName=ChapterToggle}"
                       Placement="Bottom"
                       VerticalOffset="2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ChapterPopup_Opened"
                       Closed="ChapterPopup_Closed">
                    <Border Background="#F215171B"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,0,8,8">
                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChapterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChapterItemButton}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding Label}"
                                                Click="ChapterItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 当前正在看的那一集打个勾 -->
                                                <TextBlock Grid.Column="0"
                                                           Text="&#xE73E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="#FF2E90FF"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           MaxWidth="400"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <Button Style="{StaticResource BarButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="打开视频文件" />
                <Button Style="{StaticResource BarButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="上一集" />
                <Button x:Name="PlayButton" Style="{StaticResource BarButton}" Content="&#xE768;" Click="PlayPause_Click" ToolTip="播放 / 暂停  (Ctrl+Alt+Space)" />
                <Button Style="{StaticResource BarButton}" Content="&#xE893;" Click="Next_Click" ToolTip="下一集" />
                <Button Style="{StaticResource BarTextButton}" Content="-5s"
                        PreviewMouseLeftButtonDown="Rewind_Press"
                        PreviewMouseLeftButtonUp="Rewind_Release"
                        ToolTip="快退 5 秒(按住 = 2 倍速,松开恢复)" />
                <Button Style="{StaticResource BarTextButton}" Content="+5s"
                        PreviewMouseLeftButtonDown="Forward_Press"
                        PreviewMouseLeftButtonUp="Forward_Release"
                        ToolTip="快进 5 秒(按住 = 2 倍速,松开恢复)" />

                <Border Style="{StaticResource BarSeparator}" />

                <Button x:Name="SpeedButton" Style="{StaticResource BarTextButton}" Content="1x" Click="Speed_Click" ToolTip="播放倍速:点一下换下一档" />
                <Button x:Name="MuteButton" Style="{StaticResource BarButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="静音" />
                <Slider x:Name="VolumeSlider"
                        Width="80" Height="22" Margin="4,0"
                        Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center"
                        ValueChanged="Volume_ValueChanged"
                        ToolTip="音量" />

                <Border Style="{StaticResource BarSeparator}" />

                <Button Style="{StaticResource BarButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="设置:改快捷键 / 透明度 / 音量 / 倍速" />
                <Button Style="{StaticResource BarButton}" Content="&#xE8BB;" Click="Exit_Click" ToolTip="退出 CheatSheet" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
